# Copie para .env e preencha com valores reais. .env NÃO é versionado.
# Usado tanto para a interpolação ${VAR} no docker-compose.yml quanto
# como env_file do container backend (fonte única, sem duplicação).

DB_USER=methane_app
DB_PASSWORD=changeme
DB_NAME=methane_tracker
DB_HOST=timescaledb
DB_PORT=5432

MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PATTERN=sensors/+/readings

ALERT_WINDOW_SECONDS=120
ALERT_THRESHOLD_PPM_CH4=500
ALERT_THRESHOLD_PPM_CO2=5000

# Chave de assinatura dos JWT de autenticação (POST /auth/login). Gerar um
# valor forte e único por ambiente, ex: `python -c "import secrets; print(secrets.token_hex(32))"`.
# Nunca reutilizar o valor de exemplo/dev em produção.
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Dev local: aponta pro Mailpit (docker-compose), que captura os e-mails
# sem enviar de verdade. Trocar por um SMTP real em produção.
SMTP_HOST=mailpit
SMTP_PORT=1025
ALERT_EMAIL_FROM=alerts@methane-co2-tracker.local
ALERT_EMAIL_TO=oncall@methane-co2-tracker.local

# Vazio = desabilitado. Preencher com a URL do receptor pra ativar o webhook.
ALERT_WEBHOOK_URL=

# Detecção de anomalia (Isolation Forest, por sensor+gás). Sem histórico
# mínimo, a leitura não é classificada (fica is_anomaly=false por padrão).
ANOMALY_MIN_HISTORY=50
ANOMALY_HISTORY_LIMIT=500
ANOMALY_CONTAMINATION=0.02

# Vazio = desabilitado. Notificação de anomalia é separada da de alerta de
# segurança (ALERT_WEBHOOK_URL) — menor severidade, pode ir para outro sistema.
ANOMALY_WEBHOOK_URL=

# Origens permitidas a chamar a API (separadas por vírgula) — o dashboard
# React roda em porta diferente da API (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173
