# Copie para .env e ajuste. .env não é versionado. Variáveis VITE_* são
# lidas em build-time (import.meta.env) — mudar exige rebuild, não só
# reiniciar o servidor.

# URL da API. Default (sem definir): http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# true só no build da demo pública — mostra as credenciais de demo na tela
# de login (ver LoginForm.tsx). Deixar vazio/false em qualquer instalação
# real de cliente.
VITE_DEMO_MODE=false
